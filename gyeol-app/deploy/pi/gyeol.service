[Unit]
Description=GYEOL online game server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=gyeol
Group=gyeol
WorkingDirectory=/opt/gyeol/current
EnvironmentFile=/etc/gyeol/server.env
ExecStart=/opt/gyeol/runtime/bin/node --max-old-space-size=768 /opt/gyeol/current/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=gyeol
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gyeol
MemoryHigh=1536M
MemoryMax=2G
TasksMax=128
SyslogIdentifier=gyeol

[Install]
WantedBy=multi-user.target
