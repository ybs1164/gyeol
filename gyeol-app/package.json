{
  "name": "gyeol-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gyeol/web",
    "server": "tsx packages/server/src/main.ts",
    "build": "npm run typecheck && npm run build -w @gyeol/web && npm run build:server",
    "build:server": "node tools/build_server.mjs",
    "start": "node packages/server/dist/server.mjs",
    "preview": "npm run preview -w @gyeol/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/ai && tsc -p packages/server && tsc -p apps/web --noEmit",
    "fixtures": "python tools/gen_fixtures.py",
    "puzzles": "tsx tools/gen_puzzle_bank.ts",
    "calibrate:bots": "tsx tools/calibrate_bots.ts",
    "calibrate:cognitive": "tsx tools/calibrate_cognitive_bots.ts",
    "play:cognitive": "tsx tools/play_cognitive_bots.ts",
    "play:cognitive-wide": "tsx tools/play_cognitive_wide.ts",
    "calibrate:cognitive-wide": "tsx tools/calibrate_cognitive_bots_v2.ts",
    "benchmark:cognitive-wide": "tsx tools/benchmark_cognitive_wide.ts",
    "campaign:cognitive-wide": "tsx tools/run_wide_campaign.ts",
    "bench:memory": "node --expose-gc node_modules/tsx/dist/cli.mjs tools/bench_memory.ts",
    "bench:analysis": "tsx tools/bench_analysis.ts",
    "bench:grading": "tsx tools/bench_move_grading.ts",
    "bench:win": "tsx tools/bench_win_probability.ts",
    "calibrate:win": "tsx tools/calibrate_win_probability.ts",
    "check:analysis-ui": "tsx tools/check_analysis_ui.ts",
    "check:notation-ui": "tsx tools/check_notation_ui.ts",
    "check:rating-ui": "tsx tools/check_rating_ui.ts",
    "android:sync": "npm run build -w @gyeol/web && cd apps/web && npx cap sync android",
    "android:debug": "npm run android:sync && cd apps/web/android && .\\gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd apps/web/android && .\\gradlew.bat assembleRelease",
    "package:pi": "python tools/package_pi.py",
    "db:migrate": "tsx packages/server/src/db-cli.ts migrate",
    "db:import-json": "tsx packages/server/src/db-cli.ts import-json",
    "db:verify": "tsx packages/server/src/db-cli.ts verify",
    "db:backup": "tsx packages/server/src/db-cli.ts backup",
    "db:restore-check": "tsx packages/server/src/db-cli.ts restore-check",
    "package:oracle": "python tools/package_pi.py --target oracle"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.21.5",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
